---
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  publishedAt?: string;
  status?: string;
  image?: string;
}

const {
  title,
  description,
  eyebrow,
  publishedAt,
  status,
  image = "/social-card.svg",
} = Astro.props;

const pageTitle = `${title} — Jack Cai`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <title>{pageTitle}</title>
  </head>
  <body class="report-page">
    <a class="skip-link" href="#report-content">Skip to report</a>

    <div class="report-shell report-shell--sidebar">
      <header class="report-masthead">
        <p class="report-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="report-dek">{description}</p>
        <div class="report-meta">
          <span><b>Author</b> Jack Cai</span>
          {publishedAt && <time datetime={publishedAt}>{publishedAt}</time>}
          {status && <span><b>Status</b> {status}</span>}
          <slot name="meta" />
        </div>
      </header>

      <aside class="report-sidebar"><slot name="toc" /></aside>
      <main id="report-content" class="report-content">
        <slot />
      </main>

      <footer class="report-footer">
        <slot name="footer">
          <a href="/writing/">← Writing index</a>
        </slot>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f6f7f5;
    --card: #ffffff;
    --ink: #1d232a;
    --muted: #5b6470;
    --faint: #8790a0;
    --hair: #e0e3df;
    --hair-strong: #cfd5dd;
    --accent: #2a55d4;
    --accent-soft: #e8edfc;
    --cont: #c65a2e;
    --reset: #2a55d4;
    --good: #3f9e5f;
    --bad: #b23b3b;
    --warn: #8a6516;
    --gold: #b08a1e;
    --code-bg: #eef0ec;
    --serif: Charter, "Bitstream Charter", "Iowan Old Style", Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #14181d;
      --card: #1b2129;
      --ink: #e8eaed;
      --muted: #9aa3ad;
      --faint: #6b7482;
      --hair: #2a323c;
      --hair-strong: #3a414c;
      --accent: #7d9bf2;
      --accent-soft: #202c4d;
      --cont: #e0855b;
      --reset: #7d9bf2;
      --good: #5cba7d;
      --bad: #e07f7f;
      --warn: #cfa250;
      --gold: #d4af4e;
      --code-bg: #232a33;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
  }

  .report-page {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font: 16px/1.62 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  .report-page a {
    color: var(--accent);
    text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
  }

  .report-page .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 8px 12px;
    color: var(--card);
    background: var(--accent);
    transform: translateY(-150%);
  }

  .report-page .skip-link:focus {
    transform: translateY(0);
  }

  .report-shell {
    box-sizing: content-box;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px 90px;
    display: grid;
  }

  .report-shell--sidebar {
    max-width: 1180px;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 44px;
  }

  .report-masthead {
    margin-bottom: 10px;
    padding: 58px 0 30px;
    border-bottom: 2px solid var(--ink);
  }

  .report-shell--sidebar .report-masthead,
  .report-shell--sidebar .report-footer {
    grid-column: 1 / -1;
  }

  .report-eyebrow,
  .report-toc__title {
    margin: 0 0 14px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .report-masthead h1 {
    max-width: 900px;
    margin: 0 0 14px;
    font: 700 clamp(30px, 4.6vw, 44px) / 1.14 var(--serif);
    text-wrap: balance;
  }

  .report-dek {
    max-width: 62ch;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 18px;
    text-wrap: balance;
  }

  .report-meta,
  .keyline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    color: var(--muted);
    font: 12.5px/1.5 var(--mono);
  }

  .report-meta b,
  .keyline b {
    color: var(--ink);
    font-weight: 600;
  }

  .report-meta > .keyline {
    display: contents;
  }

  .report-sidebar {
    min-width: 0;
  }

  .report-toc {
    position: sticky;
    top: 24px;
    align-self: start;
    max-height: calc(100vh - 48px);
    padding-right: 8px;
    overflow: auto;
    border-right: 1px solid var(--hair);
    font: 13.5px/1.4 var(--sans);
  }

  .report-toc__title {
    margin: 6px 0 10px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
  }

  .report-toc ol {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    list-style: none;
  }

  .report-toc li {
    margin: 0;
  }

  .report-toc a {
    display: flex;
    gap: 9px;
    align-items: baseline;
    color: var(--ink);
    text-decoration: none;
  }

  .report-toc a:hover {
    color: var(--accent);
  }

  .report-toc .n {
    min-width: 16px;
    color: var(--muted);
    font: 11px var(--mono);
  }

  .report-content {
    min-width: 0;
  }

  .report-content [id] {
    scroll-margin-top: 24px;
  }

  .report-content > .col {
    margin: 0 0 58px;
  }

  .report-content > section {
    margin: 0 0 58px;
  }

  .report-content h2 {
    margin: 44px 0 6px;
    font: 700 27px/1.2 var(--serif);
    text-wrap: balance;
    scroll-margin-top: 24px;
  }

  .report-content h2 .lab {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font: 600 12px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .report-content h2 .secno {
    margin-right: 10px;
    color: var(--muted);
    font-weight: 400;
  }

  .report-content h3 {
    margin: 28px 0 4px;
    color: var(--ink);
    font: 700 17px/1.35 var(--sans);
  }

  .report-content h4 {
    margin: 0 0 6px;
    font: 700 15.5px/1.35 var(--sans);
  }

  .report-content p,
  .report-content ul,
  .report-content ol.prose {
    max-width: 70ch;
    margin: 12px 0;
  }

  .report-content ul {
    padding-left: 22px;
  }

  .report-content li {
    margin: 5px 0;
  }

  .report-content code {
    padding: 1px 5px;
    background: var(--code-bg);
    border-radius: 4px;
    font: 0.88em var(--mono);
  }

  .report-content .muted,
  .cap {
    color: var(--muted);
  }

  .report-callout,
  .callout,
  .abstract {
    max-width: 74ch;
    margin: 18px 0;
    padding: 12px 16px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-left: 4px solid var(--accent);
    border-radius: 6px;
    font-size: 15px;
  }

  .report-callout--good {
    border-left-color: var(--good);
  }

  .report-callout--warning {
    border-left-color: var(--warn);
  }

  .report-callout__label,
  .abstract .k {
    display: block;
    margin-bottom: 0.7em;
    color: var(--accent);
    font: 700 0.72rem var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .report-callout > :last-child,
  .abstract > :last-child {
    margin-bottom: 0;
  }

  .theory-grid {
    max-width: 74ch;
    margin: 20px 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .theory-card {
    padding: 14px 15px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-top: 3px solid var(--accent);
    border-radius: 7px;
  }

  .theory-card--decision {
    border-top-color: var(--bad);
  }

  .theory-label {
    display: block;
    margin-bottom: 9px;
    color: var(--muted);
    font: 700 0.68rem var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .theory-equation {
    color: var(--ink);
    font: 600 0.98rem/1.45 var(--serif);
  }

  .theory-card p {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .theory-equation--standalone {
    max-width: 70ch;
    margin: 14px 0;
    padding: 12px 16px;
    overflow-x: auto;
    background: var(--code-bg);
    border-left: 3px solid var(--accent);
    border-radius: 5px;
    font-size: 1.08rem;
    white-space: nowrap;
  }

  .report-table,
  .tbl-wrap {
    margin: 1.4em 0 0.5em;
    overflow-x: auto;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: 5px;
  }

  .report-table table,
  .tbl-wrap table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .report-table th,
  .report-table td,
  .tbl-wrap th,
  .tbl-wrap td {
    padding: 0.6em 0.9em;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hair);
  }

  .report-table thead th,
  .tbl-wrap thead th {
    color: var(--muted);
    background: color-mix(in oklab, var(--accent) 5%, var(--card));
    font: 600 0.72rem var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .report-table tbody tr:last-child td,
  .tbl-wrap tbody tr:last-child td {
    border-bottom: 0;
  }

  .report-content td.num,
  .report-content th.num {
    text-align: right;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .report-content td.k {
    color: var(--muted);
    font: 0.8rem var(--sans);
    white-space: nowrap;
  }

  .report-content figure {
    margin: 22px 0;
    padding: 14px 14px 10px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: 8px;
  }

  .report-content figure .imgbox {
    overflow-x: auto;
  }

  .report-content figure img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .report-content figcaption {
    max-width: none;
    margin-top: 10px;
    color: var(--muted);
    font: 13.5px/1.55 var(--sans);
  }

  .report-content figcaption b {
    color: var(--ink);
  }

  .figrow {
    margin: 22px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.3em;
  }

  .figrow figure {
    margin: 0;
  }

  .diagram,
  .proto,
  .incoming {
    margin: 20px 0;
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: 8px;
    font-family: var(--sans);
  }

  .flow {
    display: flex;
    align-items: stretch;
    gap: 0.7em;
    flex-wrap: wrap;
  }

  .stage {
    min-width: 170px;
    padding: 14px 16px;
    flex: 1;
    background: var(--paper);
    border: 1px solid var(--hair-strong);
    border-radius: 7px;
  }

  .stage .t,
  .side .h {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stage.clean .t {
    color: var(--muted);
  }

  .stage .d {
    margin-top: 0.35em;
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .arrow {
    display: flex;
    align-items: center;
    color: var(--faint);
    font-size: 1.5rem;
  }

  .merge {
    margin-top: 0.9em;
    color: var(--muted);
    text-align: center;
    font-size: 0.86rem;
  }

  .contrast,
  .protos {
    margin: 20px 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 14px;
  }

  .side {
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--hair-strong);
    border-radius: 7px;
  }

  .side.works {
    border-color: color-mix(in oklab, var(--good) 45%, var(--hair-strong));
  }

  .side.dead {
    border-color: color-mix(in oklab, var(--bad) 45%, var(--hair-strong));
  }

  .side.works .h {
    color: var(--good);
  }

  .side.dead .h {
    color: var(--bad);
  }

  .side .m,
  .proto .flow {
    color: var(--ink);
    font: 12px/1.7 var(--mono);
  }

  .proto .flow {
    padding: 8px 10px;
    overflow-x: auto;
    background: var(--code-bg);
    border-radius: 6px;
    white-space: pre;
  }

  .side .n,
  .proto p,
  .incoming {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.4;
  }

  .incoming {
    max-width: 74ch;
    padding: 10px 14px;
    border-style: dashed;
    border-color: var(--accent);
    border-radius: 6px;
  }

  .incoming .tag,
  .status {
    color: var(--accent);
    font: 600 0.68rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .status {
    padding: 2px 9px;
    display: inline-block;
    color: var(--gold);
    border: 1px solid var(--hair);
    border-radius: 99px;
  }

  .pill {
    padding: 0.14em 0.55em;
    display: inline-block;
    border-radius: 20px;
    font: 600 0.72rem var(--sans);
    white-space: nowrap;
  }

  .pill.good {
    color: var(--good);
    background: color-mix(in oklab, var(--good) 14%, transparent);
  }

  .pill.bad {
    color: var(--bad);
    background: color-mix(in oklab, var(--bad) 14%, transparent);
  }

  .neg,
  .pill.good {
    color: var(--good);
  }

  .cont {
    color: var(--cont);
    font-weight: 600;
  }

  .pos {
    color: var(--bad);
  }

  .reset {
    color: var(--reset);
    font-weight: 600;
  }

  .key {
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 600;
  }

  .sw {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    display: inline-block;
    border-radius: 2px;
    vertical-align: baseline;
  }

  .sw--continue {
    background: var(--cont);
  }

  .sw--reset {
    background: var(--reset);
  }

  .report-meta-note {
    color: var(--reset);
  }

  .refs-note {
    font-size: 13px;
  }

  .cap,
  .foot,
  .refs {
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .foot {
    margin-top: 3em;
    padding-top: 1.2em;
    color: var(--faint);
    border-top: 1px solid var(--hair);
  }

  .report-footer {
    margin-top: 20px;
    padding-top: 18px;
    color: var(--muted);
    border-top: 1px solid var(--hair);
    font: 13px/1.6 var(--sans);
  }

  @media (max-width: 900px) {
    .report-shell--sidebar {
      grid-template-columns: minmax(0, 1fr);
    }

    .report-sidebar {
      grid-column: 1;
    }

    .report-toc {
      position: static;
      max-height: none;
      padding: 0 0 14px;
      overflow: visible;
      border-right: 0;
      border-bottom: 1px solid var(--hair);
    }

    .report-toc__title {
      display: block;
    }

    .report-toc ol {
      width: auto;
      flex-direction: column;
      gap: 7px;
    }

    .report-content [id] {
      scroll-margin-top: 24px;
    }
  }

  @media (max-width: 680px) {
    .report-shell {
      padding-right: 16px;
      padding-left: 16px;
    }

    .figrow,
    .contrast,
    .protos,
    .theory-grid {
      grid-template-columns: 1fr;
    }

    .flow {
      flex-direction: column;
    }

    .arrow {
      justify-content: center;
      transform: rotate(90deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
